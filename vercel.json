{
  "framework": "nextjs",
  "regions": ["MSP1", "IAD1"],
  "headers": [
    {
      "source": "/(api|mcp)(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, x402-authorization, x-payment-signature, Content-Type, Mcp-Session-Id"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "WWW-Authenticate, X-Verified-Payer, X-Settlement-Tx"
        }
      ]
    }
  ]
}
